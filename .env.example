# ================= Bichon — Railway Template =================
# End-to-end encrypted email storage (IMAP/SMTP aggregation) with Web UI.
# Docs: https://github.com/rustmailer/bichon

# --- Railway runtime ---
PORT=15630

# --- Required ---
# Absolute path for all persistent data (must match the /data volume mount).
BICHON_ROOT_DIR=/data
# Password used to encrypt stored credentials (IMAP passwords, OAuth tokens).
# Use a long random value. Changing it later locks out stored accounts.
BICHON_ENCRYPT_PASSWORD=change-me-to-a-long-random-password

# --- Recommended ---
# Public-facing URL for OAuth redirects and docs links.
BICHON_PUBLIC_URL=${{RAILWAY_PUBLIC_DOMAIN}}

# --- Optional ---
BICHON_HTTP_PORT=15630
# BICHON_LOG_LEVEL=info
# BICHON_BASE_URL=/